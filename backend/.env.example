# Required
JWT_SECRET=change-me-to-a-long-random-secret
DATABASE_URL=file:./dev.db

# Access tokens
# Short-lived when remember-me issues a refresh cookie
JWT_EXPIRES_IN=15m
# Longer-lived access token when remember-me is off (tab session via sessionStorage)
JWT_EXPIRES_IN_SESSION=8h

# Refresh cookie (remember-me)
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SAMESITE=Lax
# auto | true | false — auto uses HTTPS detection / production default
COOKIE_SECURE=auto

# CORS + public frontend URL used in password-reset emails
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# Password reset
PASSWORD_RESET_TTL_MINUTES=30

# Mail transport: file (local inbox) | smtp | memory (tests)
MAIL_TRANSPORT=file
MAIL_DIR=./.mail
MAIL_FROM=Financy <noreply@financy.local>

# SMTP (only when MAIL_TRANSPORT=smtp)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Comma-separated reverse-proxy IPs allowed to set X-Forwarded-For.
# Empty (default) = ignore forwarded headers; rate limiting uses the TCP peer only.
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2
